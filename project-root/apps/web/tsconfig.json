{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "react": [
        "./node_modules/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/react/jsx-runtime.js"
      ],
      "react/jsx-dev-runtime": [
        "./node_modules/react/jsx-dev-runtime.js"
      ],
      "react-dom": [
        "./node_modules/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/react-dom/*"
      ]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "react", "react-dom"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../packages/content/**/*.ts",
    "../../packages/interpreter/src/**/*.ts",
    "../../packages/projection/src/**/*.ts",
    "../../packages/runtime/src/**/*.ts",
    "../../packages/renderer-react/src/**/*.ts",
    "../../packages/renderer-react/src/**/*.tsx",
    "../../packages/schema/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "../../packages/**/*.test.ts",
    "../../packages/**/*.test.tsx"
  ]
}