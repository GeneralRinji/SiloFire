{
  "name": "silofire-root",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "npm --prefix ./project-root/apps/web run dev --",
    "dev:strict": "npm --prefix ./project-root/apps/web run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "dev:reset": "node ./scripts/dev_reset.mjs",
    "build": "npm --prefix ./project-root/apps/web run build",
    "preview": "npm --prefix ./project-root/apps/web run preview",
    "test": "npm --prefix ./project-root/apps/web run test",
    "typecheck": "npm --prefix ./project-root/apps/web run typecheck",
    "deno:serve": "deno task serve",
    "deno:serve:static": "deno task serve:static",
    "deno:build": "deno task build:web",
    "deno:deploy:create": "node ./scripts/deno_deploy_bridge.mjs create",
    "deno:deploy": "node ./scripts/deno_deploy_bridge.mjs deploy"
  }
}